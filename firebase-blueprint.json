{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "Hotel accommodation room details, pricing, and availability status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "short_description": { "type": "string", "maxLength": 300 },
        "full_description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "discount_price": { "type": "number" },
        "base_occupancy": { "type": "number" },
        "max_occupancy": { "type": "number" },
        "bed_type": { "type": "string", "maxLength": 50 },
        "room_size": { "type": "string", "maxLength": 50 },
        "featured_image": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["Available", "Booked", "Maintenance"] }
      },
      "required": ["name", "price", "status"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Room reservation made by a guest with billing and stay period details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "booking_number": { "type": "string", "maxLength": 50 },
        "user_id": { "type": "string", "maxLength": 128 },
        "room_id": { "type": "string", "maxLength": 64 },
        "room_name": { "type": "string", "maxLength": 100 },
        "check_in": { "type": "string", "maxLength": 20 },
        "check_out": { "type": "string", "maxLength": 20 },
        "guests": { "type": "number" },
        "rooms_count": { "type": "number" },
        "nights": { "type": "number" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Confirmed", "Pending", "Cancelled", "Completed"] },
        "payment_status": { "type": "string", "enum": ["Paid", "Pending", "Failed", "Refunded"] },
        "payment_method": { "type": "string", "maxLength": 50 },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["booking_number", "room_id", "check_in", "check_out", "total", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Guest feedback and rating for staying at Kanha Residency",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "user_name": { "type": "string", "maxLength": 100 },
        "user_location": { "type": "string", "maxLength": 100 },
        "room_id": { "type": "string", "maxLength": 64 },
        "room_name": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "review": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["Approved", "Pending", "Rejected"] },
        "verified_guest": { "type": "boolean" },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["user_name", "rating", "title", "review", "status"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Pilgrim, family, or event enquiry sent through the contact form",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["New", "Contacted", "Resolved", "Archived"] },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "email", "message", "status"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Visual media showcasing the hotel rooms, lobby, and Mathura sights",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "image": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 500 },
        "sort_order": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] }
      },
      "required": ["title", "category", "image", "status"]
    },
    "Amenity": {
      "title": "Amenity",
      "description": "Feature and comfort provided to hotel guests",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "icon": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] }
      },
      "required": ["name", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discounts for guest bookings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 30 },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "minimum_amount": { "type": "number" },
        "maximum_discount": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Expired"] }
      },
      "required": ["code", "type", "value", "status"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global hotel configurations, tax rules, and contact information",
      "type": "object",
      "properties": {
        "property_name": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "tax_percentage": { "type": "number" },
        "hero_title": { "type": "string", "maxLength": 200 }
      },
      "required": ["property_name", "phone", "email"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization registry document",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Hotel accommodation rooms and pricing details"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Guest reservations and bookings synchronized live"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Guest reviews and ratings"
    },
    "/enquiries/{enquiryId}": {
      "schema": "Enquiry",
      "description": "Contact inquiries from website visitors"
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Gallery photos for property and Mathura temple darshan"
    },
    "/amenities/{amenityId}": {
      "schema": "Amenity",
      "description": "Hotel facilities and amenities list"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Discount codes available for booking"
    },
    "/settings/{settingsId}": {
      "schema": "SiteSettings",
      "description": "Hotel master configuration and contact info"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "List of authorized administrator user IDs"
    }
  }
}
